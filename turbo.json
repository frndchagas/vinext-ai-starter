{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "stream",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".vinext/**", ".next/**", "dist/**", "openapi/**"]
    },
    "format": {
      "cache": false
    },
    "format:check": {
      "outputs": []
    },
    "lint": {
      "outputs": []
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "outputs": ["*.tsbuildinfo"]
    },
    "test": {
      "outputs": []
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "passThroughEnv": [
        "API_PORT",
        "APP_URL",
        "BROADCAST_CONNECTION",
        "CACHE_STORE",
        "DB_*",
        "MAIL_*",
        "NEXT_PUBLIC_*",
        "QUEUE_CONNECTION",
        "REDIS_*",
        "REVERB_*",
        "SESSION_DRIVER",
        "WEB_PORT"
      ]
    },
    "test:integration": {
      "cache": false
    },
    "test:e2e": {
      "cache": false
    }
  }
}
